                        },
                        "sourceCode": {
                          "code": "export const code = async (inputs) => {\n  const fail = (e) => ({ ok: false, error: e, quote_text: \"\", quote_json: \"\" });\n  const find = (v) => {\n    if (typeof v === \"string\") { try { const j = JSON.parse(v); const r = find(j); if (r) return r; } catch (e) {} return null; }\n    if (Array.isArray(v)) { for (const x of v) { const r = find(x); if (r) return r; } return null; }\n    if (v && typeof v === \"object\") { if (\"is_quote_request\" in v && \"items\" in v) return v;\n      for (const k of Object.keys(v)) { const r = find(v[k]); if (r) return r; } }\n    return null;\n  };\n  const q = find(inputs.langflowResponse);\n  if (!q) return fail(\"no_valid_json\");\n  if (q.is_quote_request !== true || !Array.isArray(q.items) || q.items.length === 0 || q.items.length > 30) return fail(\"not_a_quote_request\");\n  let prices; try { prices = JSON.parse(inputs.priceListJson); } catch (e) { return fail(\"bad_price_list\"); }\n  const vat = Number(inputs.vatRate);\n  if (!(vat >= 0 && vat < 1)) return fail(\"bad_vat\");\n  let sub = 0; const lines = [];\n  for (const it of q.items) {\n    const qty = Number(it.quantity); const p = prices[String(it.description).trim().toLowerCase()];\n    if (!(qty > 0 && qty <= 100000) || !p || !(p.unit_price > 0)) return fail(\"unpriced_item:\" + String(it.description).slice(0, 40));\n    const t = Math.round(qty * p.unit_price * 100) / 100; sub += t;\n    lines.push(String(it.description) + \" | \" + qty + \" x \" + p.unit_price + \" = \" + t.toFixed(2));\n  }\n  const vatAmt = Math.round(sub * vat * 100) / 100; const total = Math.round((sub + vatAmt) * 100) / 100;\n  const text = \"QUOTATION\\nRef: \" + inputs.ref + \"\\nCustomer: \" + (q.customer && q.customer.name || \"\") + \"\\n\\n\" + lines.join(\"\\n\") +\n    \"\\n\\nSubtotal: \" + sub.toFixed(2) + \"\\nVAT: \" + vatAmt.toFixed(2) + \"\\nTotal: \" + total.toFixed(2) + \"\\nValid for 14 days.\";\n  return { ok: true, error: \"\", quote_text: text, total: total, quote_json: JSON.stringify({ ref: inputs.ref, items: q.items, subtotal: sub, vat: vatAmt, total }) };\n};",
                          "packageJson": "{}"
                        },
