            "sourceCode": {
              "code": "export const code = async (inputs) => {\n  const MAX = 6000;\n  const redact = (s) => s.replace(/[\\w.+-]+@[\\w-]+\\.[\\w.-]+/g, \"[EMAIL]\").replace(/\\+?\\d[\\d\\s().-]{7,}\\d/g, \"[PHONE]\");\n  const raw = String(inputs.text || \"\");\n  const clean = redact(raw).slice(0, MAX);\n  const ok = !!inputs.messageId && clean.trim().length > 15;\n  const key = \"quote:\" + String(inputs.messageId || \"none\");\n  return { ok, reason: ok ? \"\" : \"empty_or_invalid_email\", key,\n           email_json: JSON.stringify({ subject: String(inputs.subject || \"\").slice(0, 200), body: clean }) };\n};",
              "packageJson": "{}"
            },
